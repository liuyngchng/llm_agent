# 智能客服系统配置文件（模板）
# 部署时复制为 cfg.yml 并根据实际环境修改：
#   cp cfg.yml.template cfg.yml
server:
  port: 19007
  debug: true
  # 运行模式:
  #   singleton — 单例模式（默认）
  #   cluster  — 集群模式
  mode: "singleton"
  # 服务角色:
  #   all   — 全功能（默认）
  #   admin — 仅管理面
  #   chat  — 仅用户聊天面
  role: "all"
  # HMAC 签名密钥（用于生成和验证登录 token）:
  #   - 单例模式：留空使用默认密钥（生产环境建议设置）
  #   - 集群模式：必须设置，所有节点必须使用相同的密钥
  #   - 生成方式：openssl rand -hex 32
  # token_secret: ""

sys:
  name: 智能客服
  auth: true

# API 配置，请在系统管理页面中设置，或直接修改此文件
api:
  llm_api_uri: ""
  llm_api_key: ""
  llm_model_name: ""

  embedding_api_uri: ""
  embedding_api_key: ""
  embedding_model_name: ""

# ============================================================
# 元数据存储配置
# ============================================================
store:
  backend: "sqlite"

mysql:
  dsn: ""

# ============================================================
# 向量存储配置
# ============================================================
vector:
  backend: "local"

milvus:
  uri: ""
  token: ""

qdrant:
  host: "localhost"
  port: 6334
  api_key: ""
  use_tls: false