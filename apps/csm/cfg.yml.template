# 智能客服系统配置文件（模板）
# 部署时复制为 cfg.yml 并根据实际环境修改：
#   cp cfg.yml.template cfg.yml
server:
  port: 19007
  debug: true

sys:
  name: 智能客服
  auth: true

# API 配置，请在系统管理页面中设置，或直接修改此文件
api:
  llm_api_uri: ""
  llm_api_key: ""
  llm_model_name: ""

  embedding_api_uri: ""
  embedding_api_key: ""
  embedding_model_name: ""

# ============================================================
# 元数据存储配置
# ============================================================
store:
  backend: "sqlite"

mysql:
  dsn: ""

# ============================================================
# 向量存储配置
# ============================================================
vector:
  backend: "local"

milvus:
  uri: ""
  token: ""

qdrant:
  host: "localhost"
  port: 6334
  api_key: ""
  use_tls: false